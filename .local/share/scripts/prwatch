#!/usr/bin/env bash
# prwatch - loudly alert when a specifically-watched PR gets reviewed.

# Make tools resolve under launchd's bare PATH.
export PATH="/opt/homebrew/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

STATE_DIR="${PRWATCH_STATE_DIR:-$HOME/.config/prwatch}"
STATE_FILE="$STATE_DIR/watchlist.json"
LOG_FILE="$STATE_DIR/prwatch.log"
ALERT_SOUND="${PRWATCH_SOUND:-/System/Library/Sounds/Hero.aiff}"
ALERT_SOUND_NAME="${PRWATCH_SOUND_NAME:-Hero}"
ALERT_REPEAT="${PRWATCH_REPEAT:-3}"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG_FILE"; }

# --- functional core ---
# args: reviews_json  seen_ids_json  my_login
# echoes JSON array of {id, login, state, submitted_at} that are new and not mine.
filter_new_reviews() {
  jq -n --argjson reviews "$1" --argjson seen "$2" --arg me "$3" '
    $reviews
    | map({id, login: .user.login, state, submitted_at})
    | map(select(.login != $me and ((.id as $i | $seen | index($i)) | not)))
  '
}

# --- impure shell ---
ensure_state() {
  mkdir -p "$STATE_DIR"
  if [ ! -f "$STATE_FILE" ]; then
    local me; me="$(gh api user -q .login)"
    jq -n --arg me "$me" '{me: $me, watches: []}' > "$STATE_FILE"
  fi
}

fire_alert() { # title  message
  local title="$1" message="$2"
  # Pass strings as argv so PR titles with quotes/backslashes can't break the AppleScript.
  osascript - "$title" "$message" "$ALERT_SOUND_NAME" <<'APPLESCRIPT' || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)
end run
APPLESCRIPT
  local i=0
  while [ "$i" -lt "$ALERT_REPEAT" ]; do afplay "$ALERT_SOUND" || true; i=$((i+1)); done
}
# Sets globals R_REPO, R_NUMBER from a URL, or a number (+ optional repo arg,
# default current dir's repo).
resolve_pr() {
  local input="${1:?usage: prwatch <add|rm> <pr-url-or-number> [owner/repo]}"
  if [[ "$input" =~ ^https?://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
    R_REPO="${BASH_REMATCH[1]}"; R_NUMBER="${BASH_REMATCH[2]}"
  else
    R_NUMBER="$input"
    R_REPO="${2:-$(gh repo view --json nameWithOwner -q .nameWithOwner)}"
  fi
}

cmd_add() {
  ensure_state
  resolve_pr "$@"
  local dup
  dup="$(jq --arg r "$R_REPO" --argjson n "$R_NUMBER" \
        '[.watches[] | select(.repo==$r and .number==$n)] | length' "$STATE_FILE")"
  if [ "$dup" -gt 0 ]; then echo "Already watching $R_REPO#$R_NUMBER"; return 0; fi

  local meta title url seen added_at tmp
  meta="$(gh api "repos/$R_REPO/pulls/$R_NUMBER" --jq '{title, url: .html_url}')"
  title="$(jq -r '.title' <<<"$meta")"
  url="$(jq -r '.url' <<<"$meta")"
  seen="$(gh api "repos/$R_REPO/pulls/$R_NUMBER/reviews" --jq '[.[].id]')"  # seed: don't alert on pre-existing
  added_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp="$(mktemp)"
  jq --arg r "$R_REPO" --argjson n "$R_NUMBER" --arg u "$url" --arg t "$title" \
     --arg a "$added_at" --argjson s "$seen" \
     '.watches += [{repo:$r, number:$n, url:$u, title:$t, added_at:$a, seen_review_ids:$s}]' \
     "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  echo "Watching $R_REPO#$R_NUMBER - $title"
}

cmd_list() {
  ensure_state
  jq -r '.watches[] | "\(.repo)#\(.number)  \(.title)\n    \(.url)"' "$STATE_FILE"
}

cmd_rm() {
  ensure_state
  resolve_pr "$@"
  local tmp; tmp="$(mktemp)"
  jq --arg r "$R_REPO" --argjson n "$R_NUMBER" \
     '.watches |= map(select(.repo != $r or .number != $n))' \
     "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  echo "Stopped watching $R_REPO#$R_NUMBER"
}
cmd_check()     { :; }        # Task 5
cmd_test_alert() {
  ensure_state
  fire_alert "prwatch test alert" "If you see + hear this, alerts work."
  echo "Fired test alert."
}

main() {
  set -euo pipefail
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    add)        cmd_add "$@" ;;
    rm)         cmd_rm "$@" ;;
    list)       cmd_list "$@" ;;
    check)      cmd_check "$@" ;;
    test-alert) cmd_test_alert "$@" ;;
    *) echo "usage: prwatch {add|rm|list|check|test-alert}" >&2; return 1 ;;
  esac
}

# Only run main when executed directly; sourcing (for tests) defines functions only.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then main "$@"; fi
