<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.brianray.prwatch</string>
  <!-- launchd does NOT expand $HOME or ~ in plist values, so run through a shell
       that expands $HOME at runtime. This keeps the plist username-agnostic;
       the script itself writes its log under $HOME/.config/prwatch. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/prwatch" check</string>
  </array>
  <key>RunAtLoad</key>        <true/>
  <key>StartInterval</key>    <integer>120</integer>
</dict>
</plist>
